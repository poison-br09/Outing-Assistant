# --- LLM: NVIDIA Nemotron (only provider) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Exact Nemotron model id from build.nvidia.com. Left blank on purpose: no assumed model name.
NVIDIA_NEMOTRON_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# --- Venue data (activities, food, place geocoding, opening hours) ---
GEOAPIFY_API_KEY=

# --- Traffic-aware routing (optional; without it travel time is a labelled estimate) ---
GOOGLE_MAPS_API_KEY=

# --- Misc ---
HTTP_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO
# Used by the Streamlit frontend
BACKEND_URL=http://localhost:8000
